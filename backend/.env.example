# TEMPLATE — safe to commit. Put REAL values in ".env" (same folder), never here.
# .env is git-ignored, so your secret key never gets committed.
#
#   Windows:   copy .env.example .env
#   macOS/Linux:  cp .env.example .env
#
# Then open .env and replace the placeholder below with your real secret key.

# Your Supabase project URL (public — not a secret).
SUPABASE_URL=https://btsjewgpwnzpljfwcbri.supabase.co

# Supabase -> Project Settings -> API -> service_role / secret key.
# KEEP THIS SECRET. Only the backend uses it. Never put it in the frontend or here.
SUPABASE_SERVICE_KEY=paste-your-service-role-secret-key-in-.env-not-here

# Comma-separated frontend origins allowed to call this API (CORS).
# Add your deployed frontend URL here too, e.g.:
# FRONTEND_ORIGINS=http://localhost:3000,https://your-app.vercel.app
FRONTEND_ORIGINS=http://localhost:3000
